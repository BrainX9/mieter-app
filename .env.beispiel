# Vorlage für die lokale Konfiguration. Kopieren nach .env und anpassen:
#   cp .env.beispiel .env
# Die .env-Datei wird nie committet.

# Zufälligen Schlüssel erzeugen:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=hier-einen-zufaelligen-schluessel-eintragen

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Passt zur Entwicklungsdatenbank aus compose.dev.yml
POSTGRES_DB=mieter
POSTGRES_USER=mieter
POSTGRES_PASSWORD=mieter-entwicklung
DATABASE_URL=postgres://mieter:mieter-entwicklung@localhost:5432/mieter

# E-Mail (Bestätigung, Passwort vergessen). Ohne Angabe: Ausgabe auf der Konsole.
# EMAIL_URL=smtp+tls://benutzer:passwort@smtp.example.org:587
# DEFAULT_FROM_EMAIL=mieter@example.org
# E-Mail-Adresse bestätigen: mandatory, optional oder none
# EMAIL_BESTAETIGUNG=mandatory

# Selbstregistrierung erlauben (Standard: aus, Konten legt der Admin an)
REGISTRIERUNG_OFFEN=False

# Anmeldung über Synology SSO Server (OIDC). Leer lassen, um sie abzuschalten.
# Redirect-URI im SSO Server: http://localhost:8000/konto/oidc/synology/login/callback/
OIDC_SERVER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_ANZEIGENAME=Synology SSO
# Bestehendes Konto mit gleicher E-Mail-Adresse über SSO anmelden (Standard: True)
# OIDC_EMAIL_VERTRAUEN=True
