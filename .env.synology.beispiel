# Vorlage für den Betrieb mit compose.yml. Kopieren nach .env (im selben Ordner wie
# compose.yml) und alle Werte in <...> ersetzen. Die .env enthält Geheimnisse:
# nie weitergeben, nie committen.

# Zufälliger Schlüssel. Erzeugen z. B. per SSH auf der Synology:  openssl rand -base64 48
SECRET_KEY=<zufaelliger-schluessel>

# Adresse, unter der die App erreichbar ist: einmal ohne, einmal mit https://
ALLOWED_HOSTS=<mieter.example.org>
CSRF_TRUSTED_ORIGINS=<https://mieter.example.org>

# Datenbank. Passwort nur aus Buchstaben und Ziffern, z. B.:  openssl rand -hex 24
POSTGRES_DB=mieter
POSTGRES_USER=mieter
POSTGRES_PASSWORD=<datenbank-passwort>

# Version des Images: latest oder eine feste Version wie 0.1.0
# MIETER_VERSION=latest
# Port auf der Synology, an den der Reverse Proxy weiterleitet
# MIETER_PORT=8000

# Nur im Heimnetz ohne HTTPS: False. Sonst so lassen.
# HTTPS=True
# HSTS erst einschalten, wenn HTTPS sicher läuft (31536000 = ein Jahr)
# HSTS_SEKUNDEN=0

# E-Mail (Bestätigung, Passwort vergessen). Ohne Angabe gehen keine Mails raus.
# EMAIL_URL=smtp+tls://<benutzer>:<passwort>@<smtp.example.org>:587
# DEFAULT_FROM_EMAIL=<mieter@example.org>
# E-Mail-Adresse bestätigen: mandatory, optional oder none
# EMAIL_BESTAETIGUNG=mandatory

# Selbstregistrierung (Standard: aus, Konten legt der Admin an)
REGISTRIERUNG_OFFEN=False

# Anmeldung über den Synology SSO Server (OIDC). Leer lassen, um sie abzuschalten.
# Redirect-URI im SSO Server: https://<mieter.example.org>/konto/oidc/synology/login/callback/
OIDC_SERVER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Protokoll: DEBUG, INFO, WARNING
# LOG_LEVEL=INFO
# gunicorn-Prozesse (2 reichen für einen Haushalt)
# GUNICORN_WORKERS=2
